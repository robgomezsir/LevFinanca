<?xml version="1.0" encoding="utf-8"?>
<!-- Só no debug: activity hospedeira dos testes de screenshot. Sem
     intent-filter de LAUNCHER: nenhum ícone extra; o Robolectric resolve o
     intent explícito do ActivityScenario pelo componente declarado.
     Não vai para o release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Tela-piloto do design system (Fase 2). Sem LAUNCHER: nenhum ícone
             novo; aberta via am start explícito. Não vai para o release. -->
        <activity
            android:name="com.example.lev.ui.theme.preview.DesignSystemPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Lev" />
    </application>
</manifest>
